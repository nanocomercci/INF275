@startuml
title Patrones de diseño aplicados en TrazaPM (TP4)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 45
hide empty members

package "Vista (MVC: View)" {
  abstract class PantallaBase {
    + {abstract} refrescar(): void
    # elegirArchivoDestino(nombre, ext): Optional<Path>
  }
  class PantallaStock
  class PantallaTrazabilidad
  PantallaBase <|-- PantallaStock
  PantallaBase <|-- PantallaTrazabilidad
}

package "Control (MVC: Controller)" {
  class Contexto <<factory>> {
    + Contexto(forzarMemoria)
    + getExportador(): Exportador
  }
  class ServicioTrazabilidad {
    + registrarMovimiento(op, s): Evento
    + generarReporteStock(): ReporteStock
  }
  class ReporteStock {
    + {static} FAMILIAS: String[]
    + {static} ESTADOS: EstadoUnidad[]
    - conteo: int[][]
  }
  abstract class OperacionTrazabilidad <<template method>> {
    + validar(s) {final}
    # {abstract} validarEspecifico(s, errores)
    + {abstract} estadoResultante(): EstadoUnidad
  }
  interface Exportador <<strategy>> {
    + exportarHistorial(h, destino)
    + exportarStock(lista, resumen, destino)
  }
  class ExportadorCsv
  interface ConectorSnt <<adapter>> {
    + informar(evento): RespuestaSnt
  }
  class ConectorSntSimulado
  Exportador <|.. ExportadorCsv
  ConectorSnt <|.. ConectorSntSimulado
}

package "Modelo y persistencia (MVC: Model + DAO)" {
  interface FuenteDatos {
    + unidades(): UnidadProductoDAO
    + eventos(): EventoDAO
    + enTransaccion(t)
  }
  interface UnidadProductoDAO
  class FuenteDatosMySQL <<JDBC>>
  class FuenteDatosMemoria
  FuenteDatos <|.. FuenteDatosMySQL
  FuenteDatos <|.. FuenteDatosMemoria
  FuenteDatos --> UnidadProductoDAO
  class UnidadProducto <<entity>>
}

PantallaStock --> ServicioTrazabilidad
PantallaStock --> Exportador
PantallaTrazabilidad --> Exportador
Contexto ..> FuenteDatos : crea MySQL\no memoria
Contexto ..> ExportadorCsv : crea
ServicioTrazabilidad --> FuenteDatos
ServicioTrazabilidad --> "5" OperacionTrazabilidad
ServicioTrazabilidad ..> ReporteStock : crea
ReporteStock ..> UnidadProducto : cuenta
ServicioTrazabilidad ..> ConectorSnt : vía ServicioIntegracion
@enduml
